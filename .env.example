# local is the zero-cost, deterministic default.
LLM_PROVIDER=local

# Optional OpenAI-compatible generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Anthropic generation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Retrieval and audit settings
RAG_TOP_K=5
AUDIT_LOG_PATH=data/audit/review_events.jsonl
